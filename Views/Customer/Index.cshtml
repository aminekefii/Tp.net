@model IEnumerable<MovieApplication.Models.Customer>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MembershiptypeID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Membershiptype)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MembershiptypeID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Membershiptype!.Name)
            </td>
            <td>
                @string.Join(", ", item.Movies.Select(m => m.Name))
            </td>
        </tr>
}
    </tbody>
</table>
